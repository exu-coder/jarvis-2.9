<?xml version="1.0" encoding="utf-8"?>
<!--
  C6: cleartext HTTP is disabled for every destination by default.

  The two plaintext endpoints this app legitimately uses are both on the local
  network, and only those are allow-listed:

    * Home Assistant          http://homeassistant.local:8123   (mDNS, *.local)
    * Ollama / local LLM      http://127.0.0.1:11434           (loopback)

  If Home Assistant is addressed by a raw LAN IP (e.g. http://192.168.1.50:8123)
  that host must be added here as its own <domain> entry, or the user should
  switch the URL to https. Nothing else in the app may speak cleartext: every
  cloud provider (DeepSeek, OpenAI, Gemini, OpenRouter, NVIDIA, Telegram) is
  reached over https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- mDNS hostnames: homeassistant.local and friends. ".local" is
             reserved for link-local mDNS (RFC 6762) and cannot resolve to a
             public host. -->
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
