+  String _ambiguousContactText(String query, Map<String, dynamic> contact) {
+    final matches =
+        ContactDisambiguationService.candidatesFromResult(contact);
+    final tails = matches.map((c) => c.lastThree).where((d) => d.isNotEmpty);
