-            signingConfig = signingConfigs.getByName("debug")
+            if (hasReleaseSigning) {
+                signingConfig = signingConfigs.getByName("release")
+            } else {
+                // !!! LOUD WARNING — NOT A PUBLISHABLE BUILD !!!
+                // No keystore found (android/key.properties missing or pointing
+                // at a file that does not exist), so this release APK falls back
