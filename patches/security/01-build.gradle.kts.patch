+                keyAlias = signingValue("keyAlias", "JARVIS_KEY_ALIAS") ?: "jarvis"
+                keyPassword = signingValue("keyPassword", "JARVIS_KEY_PASSWORD")
+                    ?: signingValue("storePassword", "JARVIS_KEYSTORE_PASSWORD")
+            }
+        }
+    }
+
     buildTypes {
         release {
-            // TODO: Add your own signing config for the release build.
