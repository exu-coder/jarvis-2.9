+          # and `flutter --version` is logged below for the record.
           channel: stable
-          flutter-version: '3.50.0'
           cache: true
 
       - name: Flutter version
@@ -39,6 +43,12 @@ jobs:
       - name: Install dependencies
         run: flutter pub get
 
+      - name: Analyze
+        run: flutter analyze
+
+      - name: Test
