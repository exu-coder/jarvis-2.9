+/// Word-boundary keyword match used by the intent router.
+///
+/// `String.contains` is a raw substring test, so "mute" matched "commute",
+/// "score" matched "underscore", and every mention of "temperature" became a
+/// weather request. `\b` on both sides keeps the router to whole words.
+bool _hasWord(String text, String word) =>
+    RegExp('\\b${RegExp.escape(word)}\\b', caseSensitive: false).hasMatch(text);
+
+bool _hasAnyWord(String text, Iterable<String> words) =>
+    words.any((w) => _hasWord(text, w));
+
+/// U3: muting is only allowed when the utterance *is* the command.
+///
+/// Anything that merely mentions muting ("this song is too loud, mute it while
+/// I read" / "silence of the lambs") now falls through to conversation instead
+/// of silencing the phone mid-sentence.
+final RegExp _muteCommandPattern = RegExp(
+  r'^(?:(?:please|jarvis|hey\s+jarvis)\s+)*'
+  r'(?:mute|silence)'
+  r'(?:\s+(?:the\s+)?(?:phone|audio|sound|volume|media|everything))?$',
+  caseSensitive: false,
+);
+
