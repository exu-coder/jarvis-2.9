+  /// Builds the chat-completions endpoint from the user-editable base URL.
+  ///
+  /// `SettingsService.baseUrl` is free text: a typo ("htp://…"), a stray space
+  /// or a broken IPv6 literal makes `Uri.parse` throw [FormatException] from
+  /// inside the request path, which surfaced as an unhandled crash rather than
+  /// a message the user could act on. Everything is normalised to
+  /// [AiException], which every caller already handles.
+  static Uri _chatCompletionsUri(String base) {
+    final trimmed = base.trim();
+    try {
+      final uri = Uri.parse('$trimmed/chat/completions');
+      if (!uri.hasScheme || uri.host.isEmpty) {
+        throw AiException(
+          'Invalid base URL: "$trimmed" is not an absolute http(s) URL.',
+        );
+      }
+      return uri;
+    } on AiException {
+      rethrow;
+    } on FormatException catch (e) {
+      throw AiException('Invalid base URL: "$trimmed" (${e.message}).');
+    }
+  }
