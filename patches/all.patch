+// ---------------------------------------------------------------------------
+// C4: real release signing.
+//
+// The release APK must never be signed with the Android debug key: that key is
+// public, so anyone could publish a malicious build that installs as an upgrade
+// over the genuine app. Create a keystore once (do NOT commit it) and describe
+// it in android/key.properties (template: android/key.properties.example):
+//
+//   keytool -genkeypair -v -keystore ~/jarvis-release.jks \
+//           -alias jarvis -keyalg RSA -keysize 2048 -validity 10000
+//
+// Passwords may also come from the environment (JARVIS_KEYSTORE_PASSWORD /
+// JARVIS_KEY_PASSWORD) so CI does not need a properties file.
+// ---------------------------------------------------------------------------
+val keystorePropertiesFile = rootProject.file("key.properties")
+val keystoreProperties = Properties()
+if (keystorePropertiesFile.exists()) {
+    FileInputStream(keystorePropertiesFile).use { keystoreProperties.load(it) }
+}
+
+fun signingValue(propertyKey: String, envKey: String): String? =
+    (keystoreProperties.getProperty(propertyKey) ?: System.getenv(envKey))
+        ?.takeIf { it.isNotBlank() }
+
+val releaseStoreFile = signingValue("storeFile", "JARVIS_KEYSTORE_FILE")
+val hasReleaseSigning = releaseStoreFile != null && File(releaseStoreFile).exists()
+
